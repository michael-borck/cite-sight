{
  "name": "@michaelborck/cite-sight-desktop",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "description": "CiteSight Desktop - Academic integrity checker",
  "author": "Michael Borck",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-borck/cite-sight.git",
    "directory": "packages/desktop"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.preload.json && vite build",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "package": "electron-builder",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@michaelborck/cite-sight-core": "*",
    "@michaelborck/cite-sight-ui": "*",
    "electron-updater": "^6.3.0",
    "jspdf": "^4.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "42.11.3",
    "electron-builder": "^26.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  }
}
