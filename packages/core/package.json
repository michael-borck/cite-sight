{
  "name": "@michaelborck/cite-sight-core",
  "version": "0.11.0",
  "description": "Core analysis library for CiteSight academic integrity checking",
  "type": "module",
  "license": "MIT",
  "author": "Michael Borck",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael-borck/cite-sight.git",
    "directory": "packages/core"
  },
  "keywords": [
    "academic",
    "integrity",
    "citations",
    "references",
    "verification",
    "apa",
    "mla",
    "chicago"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "require": "./dist/session.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js",
      "require": "./dist/review.js"
    },
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./dashboard": {
      "import": "./dist/dashboard/index.js",
      "require": "./dist/dashboard/index.js",
      "types": "./dist/dashboard/index.d.ts"
    },
    "./help": {
      "types": "./dist/help.d.ts",
      "import": "./dist/help.js",
      "require": "./dist/help.js"
    },
    "./disclaimer": {
      "import": "./dist/disclaimer.js",
      "require": "./dist/disclaimer.js",
      "types": "./dist/disclaimer.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^4.1.0"
  }
}
