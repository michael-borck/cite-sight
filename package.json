{
  "name": "cite-sight",
  "private": true,
  "version": "0.9.0",
  "description": "Academic integrity tool for checking student assignments",
  "workspaces": [
    "packages/core",
    "packages/ui-dashboard",
    "packages/desktop",
    "packages/cli",
    "packages/server",
    "packages/web",
    "packages/standalone"
  ],
  "scripts": {
    "build:core": "npm run build -w packages/core",
    "build:desktop": "npm run build -w packages/desktop",
    "build:cli": "npm run build -w packages/cli",
    "build:server": "npm run build -w packages/server",
    "build:web": "npm run build -w packages/web",
    "build:ui": "npm run build -w packages/ui-dashboard",
    "build:standalone": "npm run build -w packages/standalone",
    "build": "npm run build:core && npm run build:ui && npm run build:desktop && npm run build:cli && npm run build:server && npm run build:web && npm run build:standalone",
    "dev:desktop": "npm run dev -w packages/desktop",
    "dev:web": "npm run dev -w packages/web",
    "dev:server": "npm run dev -w packages/server",
    "dev:core": "npm run dev -w packages/core",
    "lint": "eslint packages/*/src/**/*.ts packages/*/src/**/*.tsx",
    "test:core": "npm test -w packages/core",
    "test:verification": "npm exec -w packages/core -- vitest run test/verification-benchmark.test.ts test/provider-contracts.test.ts",
    "test:cli": "npm test -w packages/cli",
    "test:server": "npm test -w packages/server",
    "test:ui": "npm test -w packages/ui-dashboard",
    "test:desktop": "npm test -w packages/desktop",
    "test:web": "npm test -w packages/web",
    "test": "npm run test:core && npm run test:cli && npm run test:server && npm run test:ui && npm run test:desktop && npm run test:web",
    "bump": "bash scripts/bump.sh"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
